# Build output. The installer is published as a release asset, not committed -
# dist/ alone is 318 MB.
dist/
build/

# Bundled payload, gathered by build.py from the local machine. ffmpeg.exe is
# 212 MB, over GitHub's 100 MB file limit, and is upstream's binary to
# distribute rather than ours to vendor into a repo.
vendor/

# Wizard BMPs, regenerated by make_wizard_art.py (build.py runs it for you).
installer/

# The banner's 432 frames, same reasoning: make_banner_assets.py draws them and
# build.py runs it whenever they are missing. assets/sound is NOT ignored -
# those are generated by synth5.py, which needs numpy and scipy, and those are
# deliberately not build dependencies.
assets/banner/

# Runtime state: the ring buffer, the log, the banner handshake file, and
# config.json, which carries this machine's device names and paths.
buffer/
nabd.log
config.json

# Hand-off files between the app and its helpers, and the two short WAVs the
# A/V test writes next to itself. From source the data directory IS the project
# folder, so all of this lands in the working tree.
.banner_trigger
.settings_trigger
.hotkeys_held
.av_test
av_click.wav
av_prime.wav
av_sync_test.mp4

# Test artefacts - screenshots and sample captures the suites leave behind.
_test/**/*.png
_test/**/*.mp4
_test/**/*.ts
_test/**/*.wav

# Local shortcuts made by setup.ps1.
*.lnk

__pycache__/
*.py[cod]

# Poster cache for the recent-nabs strip (regenerated on demand).
posters/

# The handoff zips, unpacked into docs/ already.
Claude outputs/

# Local archive of files replaced during the brand/banner/tray work, kept so a
# swap can be undone without git history. 73 MB of it is an old installer, and
# none of it is source anyone cloning this needs.
_superseded/

# Private working notes, not documentation. Carries machine-specific paths and
# an account-level to-do list; it is for moving between machines, not for
# anyone cloning this.
HANDOFF.md
