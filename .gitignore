# Build output. The installer is published as a release asset, not committed -
# dist/ alone is 318 MB.
dist/
build/

# Bundled payload, gathered by build.py from the local machine. ffmpeg.exe is
# 212 MB, over GitHub's 100 MB file limit, and is upstream's binary to
# distribute rather than ours to vendor into a repo.
vendor/

# Wizard BMPs, regenerated by make_wizard_art.py (build.py runs it for you).
installer/

# Runtime state: the ring buffer, the log, the banner handshake file, and
# config.json, which carries this machine's device names and paths.
buffer/
nabd.log
.banner_trigger
config.json

# Test artefacts - screenshots and sample captures the suites leave behind.
_test/**/*.png
_test/**/*.mp4
_test/**/*.ts
_test/**/*.wav

# Local shortcuts made by setup.ps1.
*.lnk

__pycache__/
*.py[cod]
